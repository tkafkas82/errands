# Copy to .env before running setup.sh. Local development only —
# these credentials are not intended to leave your machine.

MYSQL_ROOT_PASSWORD=errands_root
MYSQL_DATABASE=errands
MYSQL_USER=errands
MYSQL_PASSWORD=errands

# Host port the site is served on
WP_PORT=8080

# WordPress admin, created by setup.sh
WP_URL=http://localhost:8080
WP_TITLE=ERRANDS
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=errands
WP_ADMIN_EMAIL=admin@errands.local
